# Copy to `.env` and fill in only the keys for the providers you actually use.
# `uv run voice-agent` loads this file automatically (python-dotenv). Library
# code never does — only the CLI entry point, so importing the package has no
# hidden side effects. To run without it: `uv run --env-file .env <command>`.

# --- LLM (reasoning) — chapter 1 ---
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which backend to use, and optionally which model.
# One of: deepseek (default), openai, anthropic
VOICE_AGENT_PROVIDER=deepseek
# VOICE_AGENT_MODEL=deepseek-chat

# --- Server ---
# VOICE_AGENT_HOST=127.0.0.1
# VOICE_AGENT_PORT=8000

# When the agent considers speaking into a silence, in seconds, or `off` for a
# purely reactive agent. Counted from when its own voice stops, not from your
# last word. Default 5,15,28: follow up on what was just said, then offer
# something concrete, then withdraw. It may decline any of them, and usually
# does decline the first.
# VOICE_AGENT_INITIATIVE=5,15,28

# What the agent says when a conversation opens. Empty opens in silence.
# Synthesised once at startup, which also absorbs the engine's cold start.
# VOICE_AGENT_GREETING=Hi, I'm a voice agent. What can I help you with?

# --- STT (speech to text) — chapters 3, 12 ---
# AssemblyAI Universal-Streaming uses ASSEMBLYAI_API_KEY (below); the same key
# is all the streaming recognizer needs. ElevenLabs Scribe realtime uses the
# same ELEVENLABS_API_KEY as synthesis.
# One of: assemblyai (default), elevenlabs, none
VOICE_AGENT_STT=assemblyai

# How long a pause ends your turn, in seconds. Default 1.5. One knob for both
# backends: Scribe takes it as its own threshold, AssemblyAI as the ceiling of
# its turn-silence window (1.5 -> max_turn_silence=1500 ms).
# Lower feels snappier but cuts people off mid-thought; higher feels sluggish.
# This is the largest single term in the round trip — see docs/ROADMAP.md §2A.
# VOICE_AGENT_VAD_SILENCE=1.5

DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# --- TTS (text to speech) — chapter 2 ---
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# One of: elevenlabs (default), openai, none
VOICE_AGENT_TTS=elevenlabs

# Voice id (ElevenLabs) or name (OpenAI). Leave unset for the default.
# Run `uv run voice-agent --list-voices` rather than copying an id from
# anywhere: free plans cannot use Voice Library voices via the API, and which
# voices count as "stock" is not stable — Rachel (21m00Tcm4TlvDq8ikWAM) and
# Aria (9BWtsMINqrJLrRacOk9x) are both blocked on a free plan despite being
# widely recommended, Aria being ElevenLabs' own in-app default.
# VOICE_AGENT_VOICE=

# How the agent speaks about *itself* in languages that put the speaker's
# gender on past-tense verbs and adjectives — Russian, Polish, Hebrew, Arabic.
# female (default, matching the default voice), male, or neutral to avoid the
# choice where a language allows it. Change it whenever you change the voice:
# a woman's voice saying «я понял» disagrees with itself out loud.
# VOICE_AGENT_VOICE_GENDER=female

# --- What gets written down ---

# Where conversations are recorded, or `off` for none. One Markdown file per
# conversation: turns, timings, decisions, costs. No audio is ever written.
# Nothing expires — `uv run voice-agent --purge-sessions` is the delete.
# Gitignored, and personal data: a transcript is what somebody said out loud.
# VOICE_AGENT_SESSIONS=sessions

# Where the technical trace goes, or `off`. One JSONL file per run: every
# provider call with its whole prompt and reply, plus every log line, as a span
# tree. Holds bodies, so it is as sensitive as the conversation record and is
# gitignored for the same reason. API keys are redacted on the way out.
# VOICE_AGENT_TRACE=traces

# --- Telephony / transport — later chapters ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Observability (optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
